# Opcional: usar PostgreSQL en lugar de SQLite
# GDOC_DB_ENGINE=postgresql
# GDOC_DB_NAME=gdoc
# GDOC_DB_USER=postgres
# GDOC_DB_PASSWORD=tu_password
# GDOC_DB_HOST=localhost
# GDOC_DB_PORT=5432

# OCR (Fase 3): ruta a Tesseract. En Windows suele ser necesaria.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Chatbot documental Gemini
# GEMINI_API_KEY=tu-api-key
# GEMINI_MODEL=gemini-2.5-flash

# DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=tu-secret-key

# Prueba de integración con Power Automate
# POWER_AUTOMATE_URL=https://prod-xx.westus.logic.azure.com/workflows/...sig=...

# Carga documental: URL HTTPS del flujo existente (secreto, solo en .env).
# POWER_AUTOMATE_UPLOAD_URL=
# POWER_AUTOMATE_URL se admite como alias si UPLOAD_URL esta vacia.
# POWER_AUTOMATE_UPLOAD_TIMEOUT=30
# DOCUMENT_UPLOAD_MAX_BYTES=10485760
# Solo si el trigger institucional requiere Bearer (renovacion externa):
# POWER_AUTOMATE_BEARER_TOKEN=

# Flujo independiente para los requisitos de documento de identidad.
# POWER_AUTOMATE_IDENTITY_UPLOAD_URL=
# ID de DocumentoRequerido, separados por comas y verificados en cada entorno:
# POWER_AUTOMATE_IDENTITY_REQUIREMENT_IDS=
# POWER_AUTOMATE_IDENTITY_TIMEOUT=90
